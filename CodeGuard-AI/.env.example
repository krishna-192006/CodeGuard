# CodeGuard AI - Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.

# ── Google Gemini API (Optional) ──────────────────────────────────────────────
# Without this key, the application works in Rule-Based mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Request timeout in seconds
LLM_TIMEOUT=30

# ── Application Settings ──────────────────────────────────────────────────────
# Maximum allowed uploaded file size in KB
MAX_FILE_SIZE_KB=500
